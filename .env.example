# Задайте два разных секретных значения перед запуском.
TRIAGE_API_KEY=replace-with-a-long-random-key
PROXYAPI_API_KEY=replace-with-your-proxyapi-key

# Настройки сервиса.
APP_ENVIRONMENT=local
HOST_PORT=8000
DATABASE_PATH=/data/tickets.sqlite3
PROXYAPI_BASE_URL=https://api.proxyapi.ru/v1
PROXYAPI_MODEL=openai/gpt-6-luna
PROXYAPI_TIMEOUT_SECONDS=20
PROXYAPI_MAX_COMPLETION_TOKENS=1200
PROXYAPI_TEMPERATURE=none
PROXYAPI_JSON_MODE=schema
RATE_LIMIT_PER_CLIENT=5
RATE_LIMIT_GLOBAL=30
DAILY_TOKEN_BUDGET=20000
